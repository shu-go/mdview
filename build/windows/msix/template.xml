<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="mdview.exe"
        Arguments=""
        InstallLocation="C:\Program Files\shu-go\mdview">
    </Installer>
    <PackageInformation
        PackageName="mdview"
        PackageDisplayName="mdview"
        PublisherName="CN=shu-go"
        PublisherDisplayName="shu-go"
        Version="0.1.0.0"
        PackageDescription="Markdown viewer">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.github.shu-go.mdview"
                Description="Markdown viewer"
                DisplayName="mdview"
                ExecutableName="mdview.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>mdview</DisplayName>
            <PublisherDisplayName>shu-go</PublisherDisplayName>
            <Description>Markdown viewer</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="mdview.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
